PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=split_bill_tracker
# Set DB_SSL=true when connecting to hosted MySQL providers (e.g. Aiven on Render).
# Leave as false for local development.
DB_SSL=false
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Set CLIENT_URL to your deployed Vercel frontend URL in production.
CLIENT_URL=http://localhost:5173
